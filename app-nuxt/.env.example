# ==========================================================================
# Daily Stock Analysis — Nuxt (SSR) + MongoDB 环境变量
# --------------------------------------------------------------------------
# 复制本文件为 .env 后填写。所有变量同时兼容 Vercel / Cloudflare / 本地。
# Vercel 部署时在 Dashboard → Settings → Environment Variables 注入同名变量，
# 或在 vercel.json 的 `env` 中声明（cron 路由需 CRON_SECRET）。
# ==========================================================================

# ---- MongoDB（必填）------------------------------------------------------
# 本地可用 mongodb://127.0.0.1:27017
# Vercel 用 MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=daily_stock_analysis

# ---- 股票列表（必填，逗号分隔）-------------------------------------------
# 支持 A股(600519) / 港股(hk00700) / 美股(AAPL) / 日股(7203.T) 等
STOCK_LIST=600519,hk00700,AAPL

# ---- AI 模型（至少配置一个）---------------------------------------------
# 后端: litellm | gemini | openai
GENERATION_BACKEND=litellm
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 通知渠道（至少配置一个，可选）--------------------------------------
WECHAT_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 新闻/情报检索（可选，多 provider 按顺序 fallback）-------------------
# 支持 tavily / bocha / serpapi / brave，逗号分隔可填多个 key。
# 全部未配置时分析链路降级为「无新闻」，不影响主流程（fail-open）。
TAVILY_API_KEYS=
BOCHA_API_KEYS=
SERPAPI_API_KEYS=
BRAVE_API_KEYS=
# 可选：自定义 provider 优先级，默认 tavily,bocha,serpapi,brave
NEWS_PROVIDER_ORDER=

# ---- 鉴权（可选，开启后 Web 需登录）-------------------------------------
ADMIN_AUTH_ENABLED=false
ADMIN_PASSWORD=

# ---- Cron 定时分析（Vercel Cron 调用 /api/cron/daily 时需校验）----------
CRON_SECRET=

# ---- 公共变量（会暴露到浏览器，勿放密钥）-------------------------------
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_APP_NAME=Daily Stock Analysis
NUXT_PUBLIC_REPORT_LANGUAGE=zh

# ---- 系统 / 日志 ---------------------------------------------------------
LOG_LEVEL=info
TZ=Asia/Shanghai
# 定时分析时间（Vercel cron 在 vercel.json 中声明，此处仅作文档/本地参考）
SCHEDULE_TIME=18:00
